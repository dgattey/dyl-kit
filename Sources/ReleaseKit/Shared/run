#!/bin/sh
# Written by `devkit sync` from DylKit. Change DylKit's copy, not this one.
# ./run dev <devkit args> | ./run release <release-kit args> | ./run lint [dyl-lint args]
# Builds DylKit's tools once (cached in .build/release) and runs them directly. Any other mode goes to the app's own
# executable scripts/run, mode included, which sync never touches.
set -eu
root=$(cd "$(dirname "$0")" && pwd)
case "${1:-}" in
dev) tool=devkit ;;
release) tool=release-kit ;;
lint) tool=dyl-lint ;;
*)
    if [ -n "${1:-}" ] && [ -x "$root/scripts/run" ]; then exec "$root/scripts/run" "$@"; fi
    echo "usage: ./run dev|release|lint <args>, or a mode scripts/run handles  (./run dev --help)" >&2
    exit 2
    ;;
esac
shift
swift build --package-path "$root" -c release --product "$tool" -q >&2
export DYLKIT_ROOT="$root"
exec "$root/.build/release/$tool" "$@"
