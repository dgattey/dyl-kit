{
  "name": "sconeos-server",
  "private": true,
  "scripts": {
    "kit": "rm -rf node_modules/@dylkit/web && npm install --no-audit --no-fund --prefer-offline",
    "predev": "npm run kit",
    "dev": "next dev --port 3000",
    "prebuild": "npm run kit",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dylkit/web": "file:../Packages/DylKit/web",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "undici": "^6.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "19.2.15",
    "typescript": "^5.8.0"
  }
}
